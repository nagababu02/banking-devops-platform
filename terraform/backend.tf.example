# Copy this file to backend.tf only after creating the S3 state bucket.
# Replace the bucket name with a globally unique bucket owned by your AWS account.
terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_YOUR_TERRAFORM_STATE_BUCKET"
    key          = "banking-devops-platform/dev/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
